{
  "permissions": {
    "allow": [
      "Bash(./scripts/feature-workflow.sh *)",
      "Bash(./scripts/push-to-github.sh)",
      "Bash(./scripts/bump-session.sh)",
      "Bash(podman-compose *)",
      "Bash(podman ps *)",
      "Bash(podman exec saivamcloud-test *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(rm *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Write",
      "Edit",
      "Read"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-workflow.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/bump-session.sh"
          }
        ]
      }
    ]
  }
}
