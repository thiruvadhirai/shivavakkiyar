{
  "project": {
    "name": "Panchanga Calculator",
    "version": "1.0.0-beta.7",
    "description": "Hindu calendar (panchanga) calculator for Jekyll GitHub Pages site"
  },
  "features": {
    "panchanga-calculator-core": {
      "name": "Panchanga Calculator - Core Calculations",
      "status": "complete",
      "description": "Astronomical calculations using Drik Ayanamsa system for Hindu calendar",
      "implementation": [
        "assets/js/panchanga-calculator.js"
      ],
      "unitTests": [
        "tests/panchanga-calculator.test.js (15/15 passing)"
      ],
      "integrationTests": [
        "tests/panchanga-calculator-integration.test.js (70/70 passing)"
      ],
      "e2eTests": [
        "tests/e2e.spec.js (Panchanga Calculator Page tests)"
      ],
      "calculations": [
        "Drik Ayanamsa (precession correction)",
        "Tithi (lunar day, 1-30)",
        "Nakshatra (constellation, 1-27)",
        "Yoga (auspicious combination, 1-27)",
        "Karana (half-tithi, 1-60)",
        "Hora (planetary hour)",
        "Rahu Kalam (inauspicious period)",
        "Abhijit Muhurta (auspicious period)",
        "Pradosha finder (next 3 occurrences)"
      ]
    },
    "location-management": {
      "name": "Location Management & Geocoding",
      "status": "complete",
      "description": "User location input, Nominatim geocoding, localStorage caching (30-day expiry)",
      "implementation": [
        "assets/js/location-manager.js"
      ],
      "unitTests": [
        "tests/panchanga-calculator.test.js (geocoding tests)"
      ],
      "e2eTests": [
        "tests/e2e.spec.js (Location input test)"
      ],
      "features": [
        "Manual location input (NO auto-detect)",
        "City, State, Country, ZIP code support",
        "Nominatim API integration",
        "Location search with autocomplete",
        "Recently used locations dropdown",
        "localStorage caching (30-day expiry)",
        "Global location support"
      ],
      "cacheKeys": [
        "panchanga_location (selected location, 30-day expiry)",
        "panchanga_geocoding_cache (search results, indefinite)"
      ]
    },
    "panchanga-widget-full": {
      "name": "Full Panchanga Calculator Widget",
      "status": "implemented-with-issues",
      "description": "Complete interactive widget for dedicated panchanga calculator page",
      "implementation": [
        "_includes/panchanga-widget-full.html",
        "assets/css/panchanga.css",
        "_layouts/default.html (includes scripts)"
      ],
      "unitTests": [
        "tests/widget-issues.test.js (null check tests)"
      ],
      "e2eTests": [
        "tests/e2e.spec.js (Panchanga Calculator Page tests 1-8)"
      ],
      "features": [
        "Location search with autocomplete",
        "Date picker (any date)",
        "Calculate button",
        "Results display (all panchanga elements)",
        "Error handling for invalid locations",
        "Version display"
      ],
      "knownIssues": [
        {
          "issue": "Null check crash on calculate",
          "location": "panchanga-widget-full.html line 311",
          "code": "p.tithi.phase.toUpperCase()",
          "error": "Cannot read properties of undefined (reading 'toUpperCase')",
          "status": "needs-fixing",
          "fix": "Use optional chaining: p?.tithi?.phase?.toUpperCase?.()",
          "impact": "Widget crashes when tithi is undefined"
        }
      ]
    },
    "panchanga-widget-simple": {
      "name": "Simplified Pradosha Widget",
      "status": "implemented-with-issues",
      "description": "Simplified widget for Pradosha page showing next 3 Pradosha dates",
      "implementation": [
        "_includes/panchanga-widget-simple.html",
        "assets/css/panchanga.css"
      ],
      "unitTests": [
        "tests/widget-issues.test.js"
      ],
      "e2eTests": [
        "tests/e2e.spec.js (Pradosha Calculator Widget tests)"
      ],
      "features": [
        "Manual location input with autocomplete",
        "Recently used locations dropdown",
        "Next 3 Pradosha dates display",
        "3-hour Pradosha time window",
        "Expandable full panchanga details"
      ],
      "knownIssues": [
        {
          "issue": "Null check crash on display",
          "location": "panchanga-widget-simple.html line 344",
          "code": "p.tithi.phase.toUpperCase()",
          "error": "Cannot read properties of undefined (reading 'toUpperCase')",
          "status": "needs-fixing",
          "fix": "Use optional chaining: p?.tithi?.phase?.toUpperCase?.()",
          "impact": "Widget crashes when displaying results"
        }
      ]
    },
    "panchanga-page": {
      "name": "Panchanga Calculator Page",
      "status": "complete",
      "description": "Dedicated page hosting the full panchanga calculator widget",
