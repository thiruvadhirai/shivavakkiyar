{
  "name": "panchanga-calculator",
  "version": "1.0.0-beta.7",
  "description": "Hindu calendar (panchanga) calculator for Jekyll site",
  "type": "module",
  "scripts": {
    "build:timezones": "node scripts/generate-timezone-data.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e-validation",
    "test:unit": "node tests/panchanga-widgets.test.cjs && node tests/panchanga-calculator-integration.test.cjs",
    "test:integration": "node tests/panchanga-calculator-integration.test.cjs",
    "test:e2e-validation": "node tests/panchanga-e2e-drik-panchang-comparison.cjs && node tests/panchanga-e2e-365day-pradosha-validation.cjs",
    "test:e2e": "playwright test tests/e2e.spec.js tests/e2e/",
    "test:e2e:debug": "playwright test tests/e2e.spec.js tests/e2e/ --debug",
    "test:e2e:ui": "playwright test tests/e2e.spec.js tests/e2e/ --ui",
    "test:coverage": "c8 playwright test tests/e2e.spec.js tests/e2e/",
    "test:all": "npm run test && npm run test:coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "c8": "^8.0.1",
    "eslint": "^9.0.0",
    "geo-tz": "^7.0.7",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "temporal-polyfill": "^0.2.4",
    "typescript": "^5.3.0",
    "typescript-language-server": "^4.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
