{
  "name": "panchanga-calculator",
  "version": "1.0.0-beta.7",
  "description": "Hindu calendar (panchanga) calculator for Jekyll site",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest",
    "test:integration": "node tests/panchanga-calculator-integration.test.cjs",
    "test:e2e": "playwright test tests/e2e.spec.js",
    "test:e2e:debug": "playwright test tests/e2e.spec.js --debug",
    "test:e2e:ui": "playwright test tests/e2e.spec.js --ui",
    "test:coverage": "c8 playwright test tests/e2e.spec.js",
    "test:all": "npm run test && npm run test:coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "c8": "^8.0.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "typescript-language-server": "^4.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
