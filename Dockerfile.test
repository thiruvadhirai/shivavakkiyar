# Test Container for E2E & Integration Testing
# Quick setup with minimal dependencies
# Install only what's needed: Node + Playwright + system browsers

FROM node:20-slim

WORKDIR /app

# Install lightweight system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# Copy and install dependencies
COPY package.json* ./
RUN npm install @playwright/test@latest playwright@latest

# Install system dependencies for browsers FIRST
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgconf-2-4 \
    libxss1 \
    libappindicator1 \
    libindicator7 \
    libgbm1 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright browsers using the installed binary
RUN cd /app && \
    node_modules/.bin/playwright install chromium firefox

# Note: Test files and assets are mounted from source (not copied)
# This avoids rebuilding the container when code changes
# Mounts happen at runtime via podman-compose.yml volumes

# Default command: run E2E tests
CMD ["npm", "run", "test:e2e"]
